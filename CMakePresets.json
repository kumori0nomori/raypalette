{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "RAYPALETTE_BUILD_GUI": "OFF",
        "RAYPALETTE_FETCH_DEPENDENCIES": "OFF"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RAYPALETTE_ENABLE_CUDA": "ON",
        "RAYPALETTE_BUILD_GUI": "ON",
        "RAYPALETTE_FETCH_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "linux-cpu-debug",
      "displayName": "Linux CPU Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RAYPALETTE_ENABLE_CUDA": "OFF",
        "RAYPALETTE_BUILD_GUI": "ON",
        "RAYPALETTE_FETCH_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RAYPALETTE_ENABLE_CUDA": "ON",
        "RAYPALETTE_BUILD_GUI": "ON",
        "RAYPALETTE_FETCH_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "linux-cpu-release",
      "displayName": "Linux CPU Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RAYPALETTE_ENABLE_CUDA": "OFF",
        "RAYPALETTE_BUILD_GUI": "ON",
        "RAYPALETTE_FETCH_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "windows-cpu-debug",
      "displayName": "Windows CPU Debug",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RAYPALETTE_ENABLE_CUDA": "OFF",
        "RAYPALETTE_BUILD_GUI": "ON",
        "RAYPALETTE_FETCH_DEPENDENCIES": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RAYPALETTE_ENABLE_CUDA": "ON",
        "RAYPALETTE_BUILD_GUI": "ON",
        "RAYPALETTE_FETCH_DEPENDENCIES": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-cpu-release",
      "displayName": "Windows CPU Release",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RAYPALETTE_ENABLE_CUDA": "OFF",
        "RAYPALETTE_BUILD_GUI": "ON",
        "RAYPALETTE_FETCH_DEPENDENCIES": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RAYPALETTE_ENABLE_CUDA": "ON",
        "RAYPALETTE_BUILD_GUI": "ON",
        "RAYPALETTE_FETCH_DEPENDENCIES": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
